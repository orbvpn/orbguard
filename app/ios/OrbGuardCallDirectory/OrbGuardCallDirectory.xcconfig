// OrbGuardCallDirectory base settings: the app's version and build number
// (FLUTTER_BUILD_NAME / FLUTTER_BUILD_NUMBER) from Flutter's generated config,
// without Runner's CocoaPods settings. `flutter pub get` and `flutter build`
// write Generated.xcconfig. An extension's version and build must equal the
// app's or App Store validation rejects the upload.
#include "../Flutter/Generated.xcconfig"
