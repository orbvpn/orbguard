<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple - social sign-in for the shared OrbVPN/OrbNet
	     account. This entitlement is the on-device half; you MUST also enable
	     the "Sign in with Apple" capability on the App ID (Apple Developer
	     portal) and in the target's Signing & Capabilities so the provisioning
	     profile carries it, or getAppleIDCredential() fails at runtime. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- Associated Domains - passkey (WebAuthn) sign-in is bound to RP ID
	     orbvpn.com, which is the relying party the API now presents for every
	     customer surface. A credential belongs to exactly one relying party and
	     is invisible to every other, so this app, the OrbVPN app and the website
	     have to name the same one or each ends up with its own passkey that the
	     others cannot see — which is what happened while this said orbai.world.
	     iOS requires this webcredentials association plus the matching AASA file
	     at https://orbvpn.com/.well-known/apple-app-site-association, which is
	     served and carries this app's ID. You MUST also enable the "Associated
	     Domains" capability on the App ID (Apple Developer portal) so the
	     provisioning profile carries it. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:orbvpn.com</string>
	</array>

	<!-- Apple Push Notifications (FCM anti-theft wake-ups). Requires the Push
	     Notifications capability on the App ID + an APNs auth key uploaded to
	     Firebase (Apple Developer account). Set to `production` for release /
	     TestFlight / App Store builds (required by APNs for those). For a direct
	     Xcode debug build to a device you can flip this back to `development`. -->
	<key>aps-environment</key>
	<string>production</string>

	<!-- App Groups - Required for sharing data with Network Extension -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.orb.guard.shared</string>
	</array>

	<!-- Network Extensions - content filter ONLY.
	     OrbGuard ships exactly one network extension: the OrbGuardFilter
	     NEFilterDataProvider (ios/OrbGuardFilter/, managed via NEFilterManager
	     on MDM-supervised devices).

	     packet-tunnel-provider / dns-proxy / app-proxy-provider and the Personal
	     VPN entitlement were declared here but NOTHING implemented them:
	     PacketTunnelProvider.swift and VPNManager.swift are compiled into zero
	     targets, and no shipping source references NEVPNManager or
	     NETunnelProviderManager. The app only DETECTS whether a VPN/proxy is
	     active (a security signal it reports to the user) and can hand off to
	     the separate OrbVPN app — it never creates or configures a VPN itself.

	     Claiming them made App Review's automated analysis classify OrbGuard as
	     a VPN app and pause the review. Entitlements must describe what the
	     binary actually does. -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>content-filter-provider</string>
	</array>

	<!-- Access WiFi Information - Required for NEHotspotNetwork.fetchCurrent
	     (current SSID/BSSID on the com.orb.guard/wifi channel) -->
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>

	<!-- Keychain Sharing - For secure credential storage -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.orb.guard</string>
		<string>$(AppIdentifierPrefix)group.com.orb.guard.shared</string>
	</array>
</dict>
</plist>
