<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Location - required by macOS to expose WiFi SSID/BSSID via CoreWLAN -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- Camera - required for thief-selfie capture in anti-theft mode -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Must mirror Release.entitlements: flutter_secure_storage_darwin requires
	     a keychain access group on macOS, and file_picker needs read access to
	     the file the user chose. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.orb.guard</string>
	</array>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
