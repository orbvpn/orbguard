<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (medium): the mark, the name and what it does. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glance_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="16dp">

    <ImageView
        android:layout_width="98dp"
        android:layout_height="98dp"
        android:importantForAccessibility="no"
        android:src="@drawable/glance_logo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/glance_name"
            android:textColor="@color/glance_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="@string/glance_description"
            android:textColor="@color/glance_text2"
            android:textSize="12.5sp" />
    </LinearLayout>
</LinearLayout>
