<?xml version="1.0" encoding="utf-8"?>
<!-- Medium glance (4x2): the ring on the left; the title, one line (or the check
     time) and the amber Open OrbGuard chip when something waits or no check has run. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glance_bg"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="16dp">

    <include layout="@layout/glance_ring_slot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/glance_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:text="@string/glance_open"
            android:textColor="@color/glance_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/glance_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="2"
            android:textColor="@color/glance_text2"
            android:textSize="12.5sp"
            android:visibility="gone" />

        <!-- The check time under a stale line, so it still says when. -->
        <TextView
            android:id="@+id/glance_checked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/glance_text2"
            android:textSize="12.5sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/glance_chip"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/glance_chip"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/glance_open"
            android:textColor="@color/glance_amber_ink"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
