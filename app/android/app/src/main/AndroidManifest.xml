<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================ -->
    <!-- NETWORK PERMISSIONS (For threat intelligence) -->
    <!-- ============================================ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Google Play Billing — subscriptions/in-app purchases. Declaring this is
         what unlocks subscription management in Play Console (the plugin also
         merges it, but declaring explicitly avoids the "upload a new APK" gate). -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Android 13+ runtime notification permission (FCM push) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Required by WifiManager.startScan() for the com.orb.guard/wifi channel
         (network/rogue-AP scanning). Wi-Fi scan results additionally require
         ACCESS_FINE_LOCATION (declared below) and location services enabled;
         the channel returns PERMISSION_DENIED / LOCATION_DISABLED otherwise. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- On-device firewall: a local VpnService that filters DNS. BIND_VPN_SERVICE
         is enforced on the service; the foreground-service perms keep the tunnel
         alive while active. RECEIVE_BOOT_COMPLETED lets BootReceiver restore the
         firewall after a reboot when the user left it enabled. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ============================================ -->
    <!-- STORAGE PERMISSIONS (For file system scanning) -->
    <!-- ============================================ -->
    <!-- Scoped storage only. The APK/file scanner works on files the USER picks
         (SAF via file_picker), so no all-files access is needed.
         MANAGE_EXTERNAL_STORAGE is deliberately NOT declared: it powered nothing
         (the legacy scanFileSystem is root-gated and uses a root shell, not this
         permission) and Play restricts it to true file-manager/AV use. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- ============================================ -->
    <!-- DEVICE INFO (For spyware detection) -->
    <!-- ============================================ -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- ============================================ -->
    <!-- SMS — deliberately NO READ_SMS / RECEIVE_SMS. Google Play restricts
         the anti-SMS-phishing use case to vendors with a published track
         record (pre-qualification), so OrbGuard never reads the inbox or
         listens for incoming texts. The scam-text checker works on text the
         user pastes into the app or shares to it from the Messages app via
         the ACTION_SEND intent-filter on MainActivity below.
         NOTE: READ_CALL_LOG is also NOT declared — nothing in the app reads
         the call log. (The permission NAMES appear in our scanner's
         dangerous-permission lists only to flag OTHER apps that request
         them.) -->
    <!-- ============================================ -->

    <!-- ============================================ -->
    <!-- PACKAGE USAGE (Monitor app behavior) -->
    <!-- ============================================ -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- ============================================ -->
    <!-- ACCESSIBILITY — deliberately NO AccessibilityService. Detecting
         malicious accessibility services (stalkerware screen-readers) only
         needs Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES, which requires
         no permission and no service of our own (see
         MainActivity.getEnabledAccessibilityServices). -->
    <!-- ============================================ -->

    <!-- ============================================ -->
    <!-- SYSTEM FEATURES (For deep scanning) -->
    <!-- ============================================ -->
    <uses-permission android:name="android.permission.GET_TASKS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- ============================================ -->
    <!-- LOCATION (Detect location stalkers) -->
    <!-- ============================================ -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ============================================ -->
    <!-- DEVICE ADMIN (For threat removal) -->
    <!-- ============================================ -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <application
        android:label="OrbGuard"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Share to OrbGuard": the scam-text checker accepts text shared
                 from Messages/WhatsApp/any app via the system share sheet.
                 This replaces reading the SMS inbox (no SMS permissions). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Magic-link deep link: the OrbGuard-branded sign-in email links to
                 orbguard://login?code=... (backend chooses this scheme when the
                 request carries client=orbguard). Opens OrbGuard, not OrbVPN. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="orbguard" android:host="login" />
            </intent-filter>
        </activity>

        <!-- Flutter Embedding -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- On-device network firewall (local DNS-filtering VpnService).
             Google Play VpnService policy: this is a device-level security
             use (firewall). The tunnel is LOCAL ONLY — it routes just the
             virtual DNS resolver address, answers DNS on-device and forwards
             everything else over the normal network; no traffic is sent to an
             OrbGuard/VPN server, nothing is logged off-device. The user must
             accept Android's VPN consent dialog before it starts, and the use
             is disclosed in the Play listing + in-app before enabling. -->
        <service
            android:name=".OrbFirewallVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device DNS firewall that blocks malicious domains" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Restores the firewall after a reboot or app update when the user
             left it enabled; posts an honest "tap to re-enable" notification
             instead when VPN consent must be granted again. exported=false is
             fine: both actions are protected system broadcasts, which the
             system delivers regardless (same pattern WorkManager uses). -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Device administrator for remote anti-theft LOCK / WIPE. Enabling it
             is an intrusive one-time user action (the ACTION_ADD_DEVICE_ADMIN
             system screen); until the user grants it DeviceAdminBridge
             .isAdminActive() is false and remote lock/wipe honestly fail.
             BIND_DEVICE_ADMIN is enforced by the OS so only the system can
             trigger the admin callbacks. Policies declared in
             res/xml/device_admin.xml (force-lock + wipe-data). -->
        <receiver
            android:name=".OrbDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Queries for Package Visibility (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>

        <!-- Query all packages for scanning -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>

        <!-- Detect/launch the OrbVPN app for the VPN hand-off (orbvpn:// scheme). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="orbvpn" />
        </intent>
    </queries>

</manifest>